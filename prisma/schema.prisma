generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  nameKey      String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  progress     Progress?
  rounds       Round[]
  sessions     Session[]
  settings     GameSetting[]
}

model Progress {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars            Int      @default(0)
  rounds           Int      @default(0)
  perfectRounds    Int      @default(0)
  correctEnglish   Int      @default(0)
  correctMath      Int      @default(0)
  correctItalian   Int      @default(0)
  correctTime      Int      @default(0)
  correctLogic     Int      @default(0)
  correctGeography Int      @default(0)
  games            String[] @default([])
  streak           Int      @default(0)
  lastPlayed       String?
  badges           String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Partita registrata in modo autorevole dal server: `roundId` è la chiave di idempotenza.
model Round {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId   String
  /// Ricompensa calcolata dal server, riutilizzata se il client ripete la richiesta.
  reward    Json
  createdAt DateTime @default(now())

  @@unique([userId, roundId])
  @@index([userId])
  @@index([createdAt])
}

model GameSetting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  world       String
  gameId      String
  selected    String[] @default([])
  roundLength Int      @default(6)
  limit       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, world, gameId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
